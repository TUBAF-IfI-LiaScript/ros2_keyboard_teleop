<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>keyboard_teleop</name>
  <version>1.0.0</version>
  <description>Bündelt keyboard_teleop_cpp (Tastatureingabe) und keyboard_teleop_viz (Anzeige) und startet die Anzeige mit einer Launch-Datei.</description>
  <maintainer email="sebastian.zug@informatik.tu-freiberg.de">Sebastian Zug</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Ein Bündel hängt zur Laufzeit von seinen Teilen ab -->
  <exec_depend>keyboard_teleop_cpp</exec_depend>
  <exec_depend>keyboard_teleop_viz</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
